# Multi-stage Dockerfile for SentinelScan Scanner Daemon
FROM golang:1.26-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/scanner ./cmd/scanner

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app

COPY --from=builder /app/scanner /app/scanner
COPY --from=builder /app/configs/config.yaml /app/configs/config.yaml

ENTRYPOINT ["/app/scanner"]
